# GuideHerd public marketing site — security headers.
# Global posture on every path; the status page keeps its own CSP, whose
# connect-src is pinned to the status-artifact host so the page stays
# independent of any backend.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/status/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src https://raw.githubusercontent.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
